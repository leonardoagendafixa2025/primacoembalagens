<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.primacor.plmpacklib" ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="PRIMACOR EMBALAGENS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.primacor.plmpacklib.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- Suporta Adobe Illustrator CC 2019 até Illustrator 2026+ (v23.0 até v35.0) -->
            <Host Name="ILST" Version="[20.0,35.0]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="6.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.primacor.plmpacklib.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/hostscript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--enable-webgl</Parameter>
                        <Parameter>--ignore-gpu-blacklist</Parameter>
                        <Parameter>--ignore-gpu-blocklist</Parameter>
                        <Parameter>--disable-gpu-sandbox</Parameter>
                        <Parameter>--enable-gpu-rasterization</Parameter>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>PRIMACOR EMBALAGENS</Menu>
                    <Geometry>
                        <Size>
                            <Height>650</Height>
                            <Width>420</Width>
                        </Size>
                        <MinSize>
                            <Height>400</Height>
                            <Width>300</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2160</Height>
                            <Width>3840</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
